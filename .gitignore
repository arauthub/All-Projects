__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.installed.cfg
*.egg
*.manifest
*.spec
.pytest_cache/
.coverage
htmlcov/
*.sqlite3

# Virtual Environments
venv/
.venv/
env/
ENV/

# IDE & Editor Configurations
.idea/
.vscode/
*.swp
*.swo
*~

# Environment & Secrets
.env
.env.local
.env.*.local

# Logs & Temporary Files
logs/
*.log
scratch/
tmp/
temp/
