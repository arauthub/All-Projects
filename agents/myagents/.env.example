# Configuration for Google ADK Multi-Agent Orchestrator

# Server Port and Host
PORT=8080
HOST=0.0.0.0

# Optional Google Gemini API Key
# If omitted or left blank, system runs in Zero-Key Autonomous Simulation Mode
GEMINI_API_KEY=

# Model Tier ('gemini-1.5-flash' or 'gemini-1.5-pro')
GEMINI_MODEL=gemini-1.5-flash

# Environment
NODE_ENV=development
