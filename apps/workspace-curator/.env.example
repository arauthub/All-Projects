# WorkspaceCurator Pro Environment Configuration
PORT=8090
HOST=0.0.0.0
DEBUG=false

# Google Workspace Webhook Verification
# Token used to verify X-Goog-Channel-Token or Authorization bearer
WORKSPACE_WEBHOOK_SECRET=your_workspace_webhook_secret_here
REQUIRE_AUTH=false

# Optional Google Gemini Generative AI Key (leave blank to use local heuristic engine)
GEMINI_API_KEY=

# Outbound Webhook Forwarding (Slack / Discord / Zapier)
OUTBOUND_WEBHOOK_URL=
OUTBOUND_WEBHOOK_ENABLED=false
