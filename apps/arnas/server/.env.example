# Database Configuration
POSTGRES_USER=arnas_admin
POSTGRES_PASSWORD=replace_with_secure_postgres_password
POSTGRES_DB=arnas_db
DATABASE_URL=postgresql://arnas_admin:replace_with_secure_postgres_password@localhost:5432/arnas_db?schema=public

# Server Configuration
NODE_ENV=development
PORT=8080
HOST=0.0.0.0
JWT_SECRET=super_secret_jwt_token_key_change_me_in_production_32chars!
JWT_REFRESH_SECRET=super_secret_refresh_jwt_key_change_me_in_prod!
STORAGE_ROOT=./data/storage

# Media & Thumbnail Configuration
MAX_CHUNK_SIZE_BYTES=2097152
THUMBNAIL_QUALITY=80
