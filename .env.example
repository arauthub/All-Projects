# Nexus Prime: Quantum Jamstack & Git Intelligence Portal
# Environment Configuration Template

PORT=3000
HOST=localhost
NODE_ENV=development

# Optional GitHub API integration token (increases GitHub API rate limits from 60 to 5,000 req/hr)
# The portal works 100% offline out-of-the-box using the pre-rendered Jamstack static data snapshot.
GITHUB_TOKEN=your_github_personal_access_token_here
GITHUB_REPO_OWNER=arauthub
GITHUB_REPO_NAME=All-Projects

# Telemetry & Audio Settings
DEFAULT_AUDIO_ENABLED=false
DEFAULT_GRAPH_RENDER_MODE=quantum_60fps
ENABLE_SERVICE_WORKER=true
