#!/usr/bin/env bash
# .githooks/pre-commit
# Enforces pre-commit validation: blocks commits containing secrets or missing project prerequisites.

set -e

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"

echo "🔒 [Pre-Commit Gatekeeper] Running pre-commit validation checks on staged changes..."
if [ -f "$REPO_ROOT/scripts/presubmit.sh" ]; then
  bash "$REPO_ROOT/scripts/presubmit.sh" --mode=pre-commit
fi

exit 0
