#!/usr/bin/env bash
# .githooks/pre-push
# Enforces pre-push gatekeeping: runs all pre-commit checks before any project or commit can be pushed to remote.

set -e

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"

echo "🛡️  [Pre-Push Gatekeeper] Running all pre-commit checks prior to remote push..."
if [ -f "$REPO_ROOT/scripts/presubmit.sh" ]; then
  bash "$REPO_ROOT/scripts/presubmit.sh" --mode=pre-push
fi

exit 0
