#!/bin/bash
# .githooks/pre-push
# Enforces pre-push security: blocks pushes containing secrets and auto-syncs portfolio documentation.

set -e

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"

if [ -f "$REPO_ROOT/scripts/presubmit.sh" ]; then
  exec bash "$REPO_ROOT/scripts/presubmit.sh" --mode=pre-push
fi

exit 0
